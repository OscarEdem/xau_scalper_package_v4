*.log

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# ── Python virtual environments ──────────────────────────────────────────────
venv/
.venv/
env/

# ── ML Training — large raw data CSVs (re-fetch from MT5 when needed) ────────
# The CSV files are 13MB+ and don't belong in git.
# They live in ml_training/data/ and are NOT the model weights.
ml_training/data/

# ── ML Training — intermediate training outputs (staging area) ───────────────
# After training, copy .onnx + _scaler.json to rust-server/models/ instead.
# The _best.pt files are temporary checkpoints only needed during training.
ml_training/models/

# ── Rust server — deployed models ARE tracked ────────────────────────────────
# rust-server/models/ contains the canonical .onnx files baked into Docker.
# Do NOT ignore this directory — it must be committed.
# (If files grow beyond 50MB each, switch to Git LFS.)
!rust-server/models/
!rust-server/models/**

# ── Misc generated files ─────────────────────────────────────────────────────
/rust-server/m1_data.csv
/rust-server/m5_data.csv
/command.txt